# Global headers (applied to all routes)
/*
  Cache-Control: public, max-age=3600, immutable
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'
  Referrer-Policy: no-referrer-when-downgrade
  Feature-Policy: vibrate 'none'; geolocation 'none'; camera 'none'
  Permissions-Policy: geolocation=(self)

# Home page headers (set specific cache headers, or security headers)
/
  X-Robots-Tag: index, follow
  X-Frame-Options: SAMEORIGIN

# About page (noindex to prevent search engines from indexing it)
#/about
#  X-Robots-Tag: noindex, nofollow
#  Cache-Control: no-store

# Headers for specific assets (images, CSS, JS)
#/assets/*
/assets/*
  Cache-Control: public, max-age=86400, immutable

# Contact page headers (e.g., to block indexing)
#/contact
#  X-Robots-Tag: noindex, nofollow
#  Cache-Control: no-store

# API routes (if using any serverless functions or API routes in Astro)
#/api/*
#   Access-Control-Allow-Origin: *
#   Access-Control-Allow-Methods: GET, POST, OPTIONS

# Custom headers for static HTML files if needed (e.g., for '/docs' path)
#/docs/*
#  Cache-Control: public, max-age=86400

# Static file headers (optional: customize based on your file types)
