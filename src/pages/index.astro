---
import BaseHead from "@/components/BaseHead.astro";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

const title = "Sàng Lọc Chẩn Đoán Trước Sinh";
const description = "Sàng Lọc Chẩn Đoán Trước Sinh - 2025";

// Load full-size images
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/gallery/*"
);

// Load thumbnails
const thumbnails = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/thumbs/*"
);

// Prepare entries with metadata
const imageEntries = await Promise.all(
  Object.entries(images).map(async ([path, resolver]) => {
    const image = await resolver();
    const fileName = path.split("/").pop() ?? "";

    // Match thumbnail
    const thumbPath = Object.keys(thumbnails).find((key) =>
      key.endsWith(fileName)
    );
    const thumbResolver = thumbPath ? thumbnails[thumbPath] : null;
    const thumbnail = thumbResolver ? await thumbResolver() : null;

    // Optimize full image
    const optimizedImage = await getImage({ src: image.default, width: 1200 });

    // Optimize thumbnail
    const optimizedThumbnail = thumbnail?.default
      ? await getImage({ src: thumbnail.default, width: 600 })
      : optimizedImage;

    // Get dimensions
    const originalWidth = thumbnail?.default.width ?? image.default.width;
    const originalHeight = thumbnail?.default.height ?? image.default.height;

    // Create alt text from filename
    const baseName = fileName.replace(/\.[^/.]+$/, '');
    const altText = baseName
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, l => l.toUpperCase());

    return {
      optimizedImage,
      optimizedThumbnail,
      originalWidth,
      originalHeight,
      altText,
      imageUrl: optimizedImage.src,
    };
  })
);

// JSON-LD structured data for ImageGallery
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": title,
  "description": description,
  "image": imageEntries.map(entry => ({
    "@type": "ImageObject",
    "url": entry.imageUrl,
    "name": entry.altText,
    "width": entry.originalWidth,
    "height": entry.originalHeight
  }))
};
---

<BaseHead title={title} description={description} author="AREA44" og="og-image.jpg" />

<script type="application/ld+json">
  {JSON.stringify(structuredData)}
</script>

<main id="wrapper">
  <section id="main">
    {
      imageEntries.map(
        ({ optimizedImage, optimizedThumbnail, originalWidth, originalHeight, altText }, i) => (
          <article class="thumb">
            <a
              class="image"
              href={optimizedImage.src}
              title={`Xem ảnh gốc: ${altText}`}
              aria-label={`Xem ảnh lớn hơn: ${altText}`}
            >
              <Image
                src={optimizedThumbnail.src}
                width={originalWidth}
                height={originalHeight}
                alt={altText}
                loading="lazy"
              />
            </a>
          </article>
        )
      )
    }
  </section>
</main>

<!-- Scripts for gallery functionality -->
<script is:inline src="/scripts/jquery.min.js"></script>
<script is:inline src="/scripts/jquery.poptrox.min.js"></script>
<script is:inline src="/scripts/browser.min.js"></script>
<script is:inline src="/scripts/breakpoints.min.js"></script>
<script is:inline src="/scripts/main.js"></script>
