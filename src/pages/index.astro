---
import BaseHead from "@/components/BaseHead.astro";

const title = "Sàng Lọc Chẩn Đoán Trước Sinh";
const description = "Sàng Lọc Chẩn Đoán Trước Sinh - 2025";

import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// Load full-size images from gallery
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/gallery/*",
);

// Load thumbnails from thumb
const thumbnails = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/thumbs/*",
);

// Preload images & thumbnails
const imageEntries = await Promise.all(
  Object.entries(images).map(async ([path, resolver]) => {
    const image = await resolver();

    const fileName = path.split("/").pop() ?? "";

    // Find matching thumbnail
    const thumbPath = Object.keys(thumbnails).find((key) =>
      key.endsWith(fileName),
    );
    const thumbResolver = thumbPath ? thumbnails[thumbPath] : null;
    const thumbnail = thumbResolver ? await thumbResolver() : null;

    // Optimize full image
    const optimizedImage = await getImage({ src: image.default, width: 1200 });

    // Optimize thumbnail
    const optimizedThumbnail = thumbnail?.default
      ? await getImage({ src: thumbnail.default, width: 600 })
      : optimizedImage;

    return {
      optimizedImage,
      optimizedThumbnail,
      originalWidth: image.default.width,
      originalHeight: image.default.height,
    };
  }),
);
---

<html lang="vi">
  <head>
    <BaseHead
      title={title}
      description={description}
      author="AREA44"
      og="og-image.jpg"
    />
  </head>
  <body class="is-preload">
    <div id="wrapper">
      <div id="main">
        {
          imageEntries.map(
            ({
              optimizedImage,
              optimizedThumbnail,
              originalWidth,
              originalHeight,
            }) => (
              <article class="thumb">
                <a class="image" href={optimizedImage.src}>
                  <Image
                    src={optimizedThumbnail.src}
                    width={originalWidth}
                    height={originalHeight}
                    alt="Sàng lọc chẩn đoán trước sinh"
                    loading="lazy"
                  />
                </a>
              </article>
            ),
          )
        }
      </div>
    </div>
  </body><script is:inline src="/scripts/jquery.min.js"></script>
  <script is:inline src="/scripts/jquery.poptrox.min.js"></script>
  <script is:inline src="/scripts/browser.min.js"></script>
  <script is:inline src="/scripts/breakpoints.min.js"></script>
  <script is:inline src="/scripts/main.js"></script>
</html>
