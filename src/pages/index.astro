---
import BaseHead from "@/components/BaseHead.astro";
import Gallery from "@/components/Gallery.astro";
import ExternalScripts from "@/components/ExternalScripts.astro";

const title = "Sàng Lọc Chẩn Đoán Trước Sinh";
const description = "Sàng Lọc Chẩn Đoán Trước Sinh - 2025";
---

<html lang="vi">
  <head>
    <BaseHead
      title={title}
      description={description}
      author="AREA44"
      og="og-image.jpg"
    />
  </head>
  <body class="is-preload">
    <div id="wrapper">
      <Gallery />
    </div>
    <ExternalScripts />
  </body>
</html>
